# Copy to .env.local to enable multi-device sync. Without it the web app is a
# self-contained local tool — which is the default and works offline.
# VITE_SYNC_URL=ws://localhost:5191/ws

# Your own Google OAuth client id, for the "Send to Google Sheets" export.
# See docs/GOOGLE_SHEETS.md. Optional.
# VITE_GOOGLE_CLIENT_ID=
