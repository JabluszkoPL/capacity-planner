{
  "name": "@planner/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Planner for macOS",
  "author": "Planner contributors",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "pnpm build:main",
    "build:main": "node build.mjs",
    "dev": "node build.mjs && PLANNER_DEV_URL=http://localhost:5190 electron .",
    "dist:mac": "pnpm build:main && node copy-renderer.mjs && electron-builder --mac --config electron-builder.yml && cp FOR-TESTERS.md release/",
    "start": "pnpm build:main && node copy-renderer.mjs && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@planner/client-runtime": "workspace:*",
    "@planner/contracts": "workspace:*",
    "@planner/core": "workspace:*",
    "@planner/db": "workspace:*",
    "@planner/jira": "workspace:*",
    "@planner/mcp": "workspace:*",
    "@planner/web": "workspace:*",
    "electron": "^38.8.6",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
