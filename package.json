{
  "name": "capacity-planner",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first capacity planning: projects, teams and a deterministic scheduler with a Gantt timeline. Web and macOS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JabluszkoPL/capacity-planner.git"
  },
  "homepage": "https://github.com/JabluszkoPL/capacity-planner",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @planner/server --filter @planner/web dev",
    "dev:web": "pnpm --filter @planner/web dev",
    "dev:server": "pnpm --filter @planner/server dev",
    "dev:desktop": "pnpm --filter @planner/desktop dev",
    "build": "pnpm -r build",
    "build:mac": "pnpm --filter @planner/web build && pnpm --filter @planner/desktop dist:mac",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"{apps,packages}/*/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{apps,packages}/*/src/**/*.{ts,tsx,css}\"",
    "build:web": "pnpm --filter @planner/web build",
    "serve": "pnpm build:web && pnpm --filter @planner/server start",
    "version:set": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.18.2"
  }
}
